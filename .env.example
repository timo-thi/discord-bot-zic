# Discord bot token. Create it from the Discord Developer Portal.
DISCORD_TOKEN=

# Optional guild id used for fast slash-command sync during development.
# If empty, commands are synced globally and may take longer to appear.
DISCORD_GUILD_ID=

# Discord text channel id where bot logs are posted.
DISCORD_LOG_CHANNEL_ID=

# SQLite file path. The file and schema are created at startup when missing.
SQLITE_PATH=./data/discord-bot-zic.sqlite3

# Optional root folder used to resolve relative music paths.
MUSIC_ROOT=./music

# Disconnect after this many seconds when idle: no command and no active music.
IDLE_TIMEOUT_SECONDS=600

# ffmpeg executable used by discord.py voice playback.
FFMPEG_EXECUTABLE=ffmpeg

# Initial volume used for each guild, before /music volume changes it.
DEFAULT_VOLUME_PERCENT=100

# Maximum number of autocomplete results returned by Discord.
AUTOCOMPLETE_LIMIT=25

# Number of tracks displayed per /store list page.
STORE_LIST_PAGE_SIZE=10
